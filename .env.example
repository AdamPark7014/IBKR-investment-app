# Copia este archivo a .env y ajusta los valores locales.
# Nunca comprometas credenciales reales.

# Modo de operación: PAPER por defecto. Para LIVE, ver README.
MODE=PAPER

# Confirmación explícita para LIVE (requerida además del flag de config)
# Establece a 'yes' para permitir modo LIVE (con más checks).
LIVE_TRADING_CONFIRMED=no

# IB Gateway / TWS host y puertos
IB_HOST=127.0.0.1
IB_PORT_PAPER=4002
IB_PORT_LIVE=4001
IB_CLIENT_ID=123

# Cuenta esperada (para verificación adicional en LIVE)
IB_EXPECTED_ACCOUNT=

# Directorios locales
DATA_DIR=./data
CACHE_DIR=./data/cache
REPORTS_DIR=./reports
JOURNAL_DB=./data/journal.sqlite

