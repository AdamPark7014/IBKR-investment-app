# Copia este archivo a .env y ajusta los valores locales.
# Nunca comprometas credenciales reales.

# Modo de operación: PAPER por defecto. Para LIVE, ver README.
MODE=PAPER

# Confirmación explícita para LIVE (requerida además del flag de config)
# Establece a 'yes' para permitir modo LIVE (con más checks).
LIVE_TRADING_CONFIRMED=no

# IB Gateway / TWS host y puertos
IB_HOST=127.0.0.1
IB_PORT_PAPER=4002
IB_PORT_LIVE=4001
IB_CLIENT_ID=123

# Cuenta esperada (para verificación adicional en LIVE)
IB_EXPECTED_ACCOUNT=

# Directorios locales
DATA_DIR=./data
CACHE_DIR=./data/cache
REPORTS_DIR=./reports
JOURNAL_DB=./data/journal.sqlite

# Trading (nested; usa __ como separador)
TRADING__ALLOW_SHORT=false
TRADING__REBALANCE_BAND_PCT=0.0
# DIRECTION: long_only | short_only | long_short
TRADING__DIRECTION=long_only
#
# Histeresis costo-aware (opcional). Sólo se aplica si alguno > 0.
# Se ejecuta la orden únicamente si beneficio_esperado > comisión + slippage + coste_riesgo.
TRADING__BENEFIT_BPS=0.0
TRADING__RISK_COST_BPS=0.0

# Riesgo (objetivo de volatilidad y umbral de veto por régimen)
RISK__TARGET_VOL_ANNUAL=0.10
RISK__RISK_ON_THRESHOLD=0.50
# Límites de pérdida: estos son los defaults de RiskConfig (ver RISK_MODEL.md).
# Descomenta y ajusta para cambiarlos.
# RISK__DAILY_LOSS_LIMIT_PCT=5
# RISK__CUMULATIVE_LOSS_LIMIT_PCT=20
# RISK__DRAWDOWN_LIMIT_PCT=20
# RISK__TARGET_VOL_ANNUAL=0.10

# Data (max edad para aceptar cache, en días)
DATA__MAX_CACHE_AGE_DAYS=7


# --- Fase 1 del playbook (21-10-2026) ---
# Datos point-in-time: proveedor Tiingo (tier Starter gratis: 500 simbolos/mes, 50 req/h) y vintages con manifiesto
# DATA__TIINGO_TOKEN=
# DATA__PROVIDERS=["tiingo","yahoo"]
# DATA__UNIVERSE_FILE=./config/universe-10etf.json
# DATA__VINTAGE_DIR=./data/vintages
# DATA__MAX_PRICE_SPIKE_PCT=25
# Costos IBKR (ver COST_MODEL.md): fixed|tiered y spread_impact|bps
# COMMISSION__MODEL=fixed
# SLIPPAGE__MODEL=spread_impact
# SLIPPAGE__HALF_SPREAD_MULT=1.0
# Disciplina de investigacion (ver docs/research/PROTOCOLO-INVESTIGACION.md)
# RESEARCH__HOLDOUT_START=2024-01-01
# RESEARCH__TRIAL_BUDGET_TARGET_SHARPE=1.0
